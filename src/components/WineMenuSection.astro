---
import "../styles/wine-notes.css";
import { wineCategories } from "../data/cartas";
import { languages, localizedPath, type Language } from "../i18n/config";
import BrandLogo from "./BrandLogo.astro";
import LanguageMenu from "./LanguageMenu.astro";

interface Props { lang: Language; backLabel: string }

