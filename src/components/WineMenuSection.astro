type WineMenuCopy = {
  title: string;
  intro: string;
  menuLabel: string;
  categoryTitles: Record<WineCategoryId, string>;
  categoryNotes: Record<WineCategoryId, string>;
  glassLabels: Record<WineCategoryId, string>;
