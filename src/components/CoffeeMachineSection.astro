  it: "Scopri il nostro caffè",
};
const coffeeMenuPath = `${localizedPath(lang, "menu")}cafes-bebidas-cocteles/`;
---

<DeferredStyles href={coffeeMachineStylesHref} />
<section class="coffee-machine-section" aria-labelledby="coffee-machine-title" data-loop-motion>
  <span class="coffee-machine-section__shape" aria-hidden="true"></span>
  <span class="coffee-machine-section__line coffee-machine-section__line--top" aria-hidden="true"></span>
  <span class="coffee-machine-section__line coffee-machine-section__line--bottom" aria-hidden="true"></span>
  <span class="coffee-machine-section__particle coffee-machine-section__particle--one" aria-hidden="true"></span>
  <span class="coffee-machine-section__particle coffee-machine-section__particle--two" aria-hidden="true"></span>

  <div class="tr-shell coffee-machine-section__grid">
    <figure class="coffee-machine-photo reveal" data-reveal>
      <picture class="coffee-machine-photo__picture">
        <source
          type="image/avif"
          srcset="/images/la-marzocco-fb70-tr3c3-480.avif 480w, /images/la-marzocco-fb70-tr3c3-640.avif 640w, /images/la-marzocco-fb70-tr3c3-828.avif 828w, /images/la-marzocco-fb70-tr3c3-1080.avif 1080w, /images/la-marzocco-fb70-tr3c3.avif 1600w"
          sizes="(max-width: 650px) 92vw, (max-width: 980px) 78vw, 48vw"
        />
        <source
          type="image/webp"
          srcset="/images/la-marzocco-fb70-tr3c3-480.webp 480w, /images/la-marzocco-fb70-tr3c3-640.webp 640w, /images/la-marzocco-fb70-tr3c3-828.webp 828w, /images/la-marzocco-fb70-tr3c3-1080.webp 1080w, /images/la-marzocco-fb70-tr3c3.webp 1600w"
          sizes="(max-width: 650px) 92vw, (max-width: 980px) 78vw, 48vw"
        />
        <img
          src="/images/la-marzocco-fb70-tr3c3.webp"
          alt="Máquina La Marzocco FB70 de tres grupos en TR3C3 Speciality Coffee & Brunch en Miami Platja"
          title="La Marzocco FB70 · TR3C3 Miami Platja"
          width="1600"
          height="927"
          loading="lazy"
          decoding="async"
          class="coffee-machine-photo__img"
        />
      </picture>
      <span class="coffee-machine-photo__shadow" aria-hidden="true"></span>
      <span class="coffee-machine-photo__steam coffee-machine-photo__steam--one" aria-hidden="true"></span>
      <span class="coffee-machine-photo__steam coffee-machine-photo__steam--two" aria-hidden="true"></span>
      <ul class="coffee-machine-specs" aria-label={copy.badge}>
        {machineSpecs.map((spec) => <li>{spec}</li>)}
      </ul>
    </figure>

    <div class="coffee-machine-copy">
      <span class="coffee-machine-copy__badge reveal" data-reveal>{copy.badge}</span>
      <p class="editorial-kicker coffee-machine-copy__eyebrow reveal" data-reveal>{copy.eyebrow}</p>
      <h2 id="coffee-machine-title" class="reveal" data-reveal>{copy.title}</h2>
      <div class="coffee-machine-copy__text reveal" data-reveal>
        <p>{copy.lead}</p>
        <p>{copy.secondary}</p>
      </div>

      <div class="coffee-machine-features" aria-label={copy.title}>
        {copy.features.map((feature, index) => (
          <article class="coffee-machine-card reveal" data-reveal style={`--delay:${index * 85}ms`}>
            <span aria-hidden="true">0{index + 1}</span>
            <h3>{feature.title}</h3>
            <p>{feature.text}</p>
          </article>
        ))}
      </div>

      <p class="coffee-machine-copy__seal reveal" data-reveal>{copy.seal}</p>
      <p class="coffee-machine-copy__note reveal" data-reveal>{copy.note}</p>
      <ContextualCta className="coffee-machine-copy__cta" href={coffeeMenuPath} label={coffeeCta[lang]} ariaLabel={coffeeCta[lang]} tone="copper" />
    </div>
  </div>
</section>
