  es: ["Extracción precisa", "Presión estable", "Café con carácter", "Respeta cada grano"],
  ca: ["Extracció precisa", "Pressió estable", "Cafè amb caràcter", "Respecta cada gra"],
  en: ["Precise extraction", "Stable pressure", "Coffee with character", "Built for every bean"],
  fr: ["Extraction précise", "Pression stable", "Café de caractère", "Respect de chaque grain"],
  de: ["Präzise Extraktion", "Stabiler Druck", "Kaffee mit Charakter", "Für jede Bohne gedacht"],
  zh: ["精准萃取", "稳定压力", "有性格的咖啡", "尊重每颗咖啡豆"],
  nl: ["Precieze extractie", "Stabiele druk", "Koffie met karakter", "Voor elke boon"],
  it: ["Estrazione precisa", "Pressione stabile", "Caffè con carattere", "Rispetta ogni chicco"],
};

const copy = copyByLanguage[lang];
const machineSpecs = machineSpecsByLanguage[lang] ?? machineSpecsByLanguage.es;
const coffeeCta: Record<Language, string> = {
  es: "Descubre nuestro café",
  ca: "Descobreix el nostre cafè",
  en: "Discover our coffee",
  fr: "Découvrez notre café",
  de: "Entdecke unseren Kaffee",
  zh: "探索我们的咖啡",
