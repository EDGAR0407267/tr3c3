---
import { getHeroTranslation, getTranslation, localizedPath, type Language } from "../i18n/config";
import { BUSINESS_NAME } from "../data/site";
import OrganicDivider from "./OrganicDivider.astro";
import "../styles/hero-cinema.css";
import "../styles/hero-all-day.css";

interface Props { lang: Language }
const { lang } = Astro.props;
const t = getTranslation(lang);
const hero = getHeroTranslation(lang);
const menuPath = localizedPath(lang, "menu");
const contactPath = `${localizedPath(lang, "contact")}#contenido`;
const reserveCta: Record<Language, string> = {
  es: "Reservar mesa",
  ca: "Reservar taula",
  en: "Book a table",
  fr: "Réserver une table",
  de: "Tisch reservieren",
  zh: "预订餐桌",
  nl: "Tafel reserveren",
  it: "Prenota un tavolo",
};
---

<section class="hero-cover hero-cinema" aria-labelledby="hero-title" aria-describedby="hero-description" data-loop-motion>
  <div class="hero-cinema__media" data-hero-parallax>
    <picture class="hero-cinema__fallback">
      <source
        srcset="/images/hero-tr3c3-coffee-brunch-480.avif 480w, /images/hero-tr3c3-coffee-brunch-640.avif 640w, /images/hero-tr3c3-coffee-brunch-828.avif 828w, /images/hero-tr3c3-coffee-brunch-1080.avif 1080w, /images/hero-tr3c3-coffee-brunch.avif 1600w"
        sizes="100vw"
        type="image/avif"
      />
      <source
        srcset="/images/hero-tr3c3-coffee-brunch-480.webp 480w, /images/hero-tr3c3-coffee-brunch-640.webp 640w, /images/hero-tr3c3-coffee-brunch-828.webp 828w, /images/hero-tr3c3-coffee-brunch-1080.webp 1080w, /images/hero-tr3c3-coffee-brunch.webp 1600w"
        sizes="100vw"
        type="image/webp"
      />
      <img
        src="/images/hero-tr3c3-coffee-brunch.webp"
        alt=""
        width="1600"
        height="900"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>

    <video
      class="hero-cinema__video"
      autoplay
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
      data-hero-video
    >
      <!-- Vídeo temporal seleccionado: https://pixabay.com/videos/latte-art-coffee-33434/ · Pixabay Content License. -->
      <!-- TODO: Sustituir este vídeo temporal por el vídeo oficial de TR3C3. -->
    </video>
  </div>

  <div class="hero-cinema__shade" aria-hidden="true"></div>
  <div class="hero-cinema__grain" aria-hidden="true"></div>

  <div class="tr-shell hero-cinema__layout">
    <div class="hero-cinema__content">
      <p class="hero-cinema__eyebrow" data-hero-reveal>{hero.offer}</p>

      <h1 id="hero-title" class="hero-cinema__title" aria-label={`${BUSINESS_NAME}, ${hero.statement}`}>
        <span class="hero-cinema__title-mask"><span class="hero-cinema__brand">TR3C3</span></span>
        <span class="hero-cinema__title-claim">{hero.statement}</span>
      </h1>

      <p id="hero-description" class="hero-cinema__description" data-hero-reveal>{hero.description}</p>
      <p class="hero-cinema__location" data-hero-reveal>
        <span aria-hidden="true"></span>{hero.location}
      </p>

      <div class="hero-cinema__actions" data-hero-reveal>
        <a class="hero-cinema__primary" href={menuPath}>
          <span>{t.home.menuCta}</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
        </a>
        <a class="hero-cinema__secondary" href={contactPath}>
          <span>{reserveCta[lang]}</span><span aria-hidden="true">&#8594;</span>
        </a>
      </div>
    </div>
  </div>

  <a class="hero-cinema__scroll" href="#home-ritual-title">
    <span>{hero.scroll}</span><i aria-hidden="true"></i>
  </a>

  <OrganicDivider tone="cream" variant="shore" className="hero-cinema__divider" />
</section>

