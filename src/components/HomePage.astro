---
import BaseLayout from "../layouts/BaseLayout.astro";
import DeferredStyles from "./DeferredStyles.astro";
import homeDeferredStylesHref from "../styles/home-deferred.css?url";
import homeExperienceStylesHref from "../styles/home-experience.css?url";
import CoffeeMachineSection from "./CoffeeMachineSection.astro";
import HeroCover from "./HeroCover.astro";
import InstagramGallery from "./InstagramGallery.astro";
import LocationHoursSection from "./LocationHoursSection.astro";
import OrganicDivider from "./OrganicDivider.astro";
import ScrollImageCollage from "./ScrollImageCollage.astro";
import Img from "./Img.astro";
import SpecialityCoffeeSection from "./SpecialityCoffeeSection.astro";
import AllDayExperience from "./AllDayExperience.astro";
import { GOOGLE_MAPS_URL } from "../data/location";
import { SITE_URL } from "../data/site";
import { cartaSections } from "../data/cartas";
import { homeExperienceCopy } from "../data/home-experience";
import { getFoodMenu, localize } from "../data/food-menus";
import { cartaPortalCopy, localizeCarta } from "../data/carta-portal";
import { getTranslation, localizedPath, type Language } from "../i18n/config";
import { getPageSeo } from "../config/seo";

interface Props { lang: Language }
const { lang } = Astro.props;
const t = getTranslation(lang);
const menuPath = localizedPath(lang, "menu");
const seo = getPageSeo(lang, "home");
const experience = homeExperienceCopy[lang];
const canonicalHome = new URL(localizedPath(lang), SITE_URL).toString();
const visitSectionSchema = {
  "@context": "https://schema.org",
  "@type": "WebPageElement",
  "@id": `${canonicalHome}#visit`,
  name: lang === "es" ? "Visítanos en Miami Platja" : "Visit TR3C3 in Miami Platja",
  isPartOf: { "@id": `${canonicalHome}#webpage` },
  about: { "@id": new URL("/#local-business", SITE_URL).toString() },
};

const cardCta: Record<Language, { menu: string; wine: string }> = {
  es: { menu: "Ver carta", wine: "Ver carta de vinos" },
  ca: { menu: "Veure carta", wine: "Veure carta de vins" },
  en: { menu: "View menu", wine: "View wine list" },
  fr: { menu: "Voir la carte", wine: "Voir la carte des vins" },
  de: { menu: "Karte ansehen", wine: "Weinkarte ansehen" },
  zh: { menu: "查看菜单", wine: "查看酒单" },
  nl: { menu: "Bekijk menu", wine: "Bekijk wijnkaart" },
  it: { menu: "Vedi il menu", wine: "Vedi la carta dei vini" },
};

const featuredIds = ["cafes-bebidas-cocteles", "desayunos-brunch", "comida-cena", "vinos"];
const cardBadgesByLanguage: Record<Language, Record<string, string>> = {
  es: { "cafes-bebidas-cocteles": "Speciality", "desayunos-brunch": "Favoritos de brunch", "comida-cena": "Noches mediterráneas", vinos: "Bodega mediterránea" },
  ca: { "cafes-bebidas-cocteles": "Speciality", "desayunos-brunch": "Preferits de brunch", "comida-cena": "Nits mediterrànies", vinos: "Celler mediterrani" },
  en: { "cafes-bebidas-cocteles": "Specialty", "desayunos-brunch": "Brunch favourites", "comida-cena": "Mediterranean nights", vinos: "Mediterranean cellar" },
  fr: { "cafes-bebidas-cocteles": "Spécialité", "desayunos-brunch": "Favoris du brunch", "comida-cena": "Soirées méditerranéennes", vinos: "Cave méditerranéenne" },
  de: { "cafes-bebidas-cocteles": "Specialty", "desayunos-brunch": "Brunch-Favoriten", "comida-cena": "Mediterrane Abende", vinos: "Mediterraner Weinkeller" },
  zh: { "cafes-bebidas-cocteles": "精品咖啡", "desayunos-brunch": "早午餐精选", "comida-cena": "地中海之夜", vinos: "地中海酒窖" },
  nl: { "cafes-bebidas-cocteles": "Specialty", "desayunos-brunch": "Brunchfavorieten", "comida-cena": "Mediterrane avonden", vinos: "Mediterrane wijnkelder" },
  it: { "cafes-bebidas-cocteles": "Specialty", "desayunos-brunch": "Preferiti del brunch", "comida-cena": "Notti mediterranee", vinos: "Cantina mediterranea" },
};
const cardBadges = cardBadgesByLanguage[lang] ?? cardBadgesByLanguage.es;
const featuredSections = featuredIds
  .map((id) => cartaSections.find((section) => section.id === id))
  .filter((section): section is (typeof cartaSections)[number] => Boolean(section))
  .map((section) => {
    const foodMenu = getFoodMenu(section.id);
    if (foodMenu) return {
      ...section,
      title: localize(foodMenu.title, lang),
      lead: localize(foodMenu.lead, lang),
      alt: localize(foodMenu.alt, lang),
    };
    if (section.id === "vinos") return {
      ...section,
      title: localizeCarta(cartaPortalCopy.wineCard.title, lang),
      lead: localizeCarta(cartaPortalCopy.wineCard.lead, lang),
      alt: localizeCarta(cartaPortalCopy.wineCard.alt, lang),
    };
    return section;
  });
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  lang={lang}
  page="home"
  canonicalPath={localizedPath(lang)}
  image="/images/hero-tr3c3-coffee-brunch.webp"
  imageAlt="Café de especialidad, desayunos, brunch y cena mediterránea en TR3C3 Miami Platja"
  schema={visitSectionSchema}
  preloadImage
  preloadImageHref="/images/hero-tr3c3-coffee-brunch.avif"
  preloadImageType="image/avif"
  preloadImageSrcset="/images/hero-tr3c3-coffee-brunch-480.avif 480w, /images/hero-tr3c3-coffee-brunch-640.avif 640w, /images/hero-tr3c3-coffee-brunch-828.avif 828w, /images/hero-tr3c3-coffee-brunch-1080.avif 1080w, /images/hero-tr3c3-coffee-brunch.avif 1600w"
  preloadImageSizes="100vw"
  floatingHeader
>
  <DeferredStyles href={homeDeferredStylesHref} />
  <DeferredStyles href={homeExperienceStylesHref} />
  <HeroCover lang={lang} />

  <SpecialityCoffeeSection lang={lang} />

  <OrganicDivider tone="paper" variant="shore" className="home-divider home-divider--machine" />
  <CoffeeMachineSection lang={lang} />
  <AllDayExperience lang={lang} />

  <section class="home-menu-editorial reveal" data-reveal aria-labelledby="home-menu-title">
    <span class="home-menu-editorial__spoon" aria-hidden="true"></span>
    <div class="tr-shell home-menu-editorial__head">
      <div>
        <p class="editorial-kicker">{experience.menu.kicker}</p>
        <h2 id="home-menu-title">{experience.menu.title}</h2>
      </div>
      <div>
        <p>{experience.menu.lead}</p>
        <a class="tr-button tr-button--secondary" href={menuPath}>{experience.menu.cta}</a>
      </div>
    </div>
    <div class="tr-shell home-menu-editorial__grid">
      {featuredSections.map((section, index) => (
        <a class:list={["home-menu-card", `home-menu-card--${section.id}`]} href={`${menuPath}${section.id}/`} style={`--menu-card-index:${index};`}>
          <figure class="home-menu-card__media">
            <Img src={section.image} alt={section.alt} width={1200} height={900} sizes="(max-width: 760px) 92vw, (max-width: 1080px) 44vw, 24vw" />
          </figure>
          <div class="home-menu-card__body">
            <span class="home-menu-card__badge">{cardBadges[section.id]}</span>
            <span class="home-menu-card__index">{String(index + 1).padStart(2, "0")}</span>
            <h3>{section.title}</h3>
            <p>{section.lead}</p>
            <span class="home-menu-card__cta">{section.id === "vinos" ? cardCta[lang].wine : cardCta[lang].menu} <span aria-hidden="true">↗</span></span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <ScrollImageCollage lang={lang} />

  <OrganicDivider tone="paper" variant="ribbon" className="home-divider home-divider--gallery" />
  <InstagramGallery lang={lang} />
  <OrganicDivider tone="cream" variant="terrace" className="home-divider home-divider--visit" />
  <LocationHoursSection lang={lang} />
  <OrganicDivider tone="cream" variant="slow" className="home-divider home-divider--final" />

  <section class="editorial-final-cta home-final-scene reveal" data-reveal>
    <div class="tr-shell">
      <p class="editorial-kicker">TR3C3 · Miami Platja</p>
      <h2>{t.home.contactTitle}</h2>
      <div class="editorial-actions">
        <a class="tr-button tr-button--primary" href={menuPath}>{t.home.menuCta}</a>
        <a class="tr-button tr-button--secondary" href={GOOGLE_MAPS_URL} target="_blank" rel="noopener noreferrer">{t.home.mapCta}</a>
      </div>
    </div>
  </section>
</BaseLayout>
