---
import { GOOGLE_MAPS_EMBED_URL, GOOGLE_MAPS_URL } from "../data/location";
import { BUSINESS_ADDRESS } from "../data/site";
interface Props { label?: string; className?: string }
const { label = "Abrir ubicación de TR3C3 en Google Maps", className = "" } = Astro.props;
---
<div class:list={["tr-map-preview", className]}>
  <div
    class="tr-map-preview__frame"
    data-src={GOOGLE_MAPS_EMBED_URL}
    data-map-facade
    data-title="Ubicación de TR3C3 Brunch en Google Maps"
    data-referrerpolicy="no-referrer-when-downgrade"
    data-allowfullscreen
    role="img"
    aria-label="Ubicación de TR3C3 Brunch en Google Maps"
  >
    <strong>TR3C3</strong>
    <span>MIAMI PLATJA · COSTA DAURADA</span>
  </div>
  <span class="tr-map-preview__sheen" aria-hidden="true"></span>
  <span class="tr-map-preview__place">Miami Platja<small>{BUSINESS_ADDRESS.streetAddress} · Costa Daurada</small></span>
  <a class="tr-map-preview__open" href={GOOGLE_MAPS_URL} target="_blank" rel="noopener noreferrer" aria-label={label}>
    Cómo llegar <span aria-hidden="true">→</span>
  </a>
</div>


