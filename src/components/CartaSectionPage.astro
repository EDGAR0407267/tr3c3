---
import BaseLayout from "../layouts/BaseLayout.astro";
import InternalHero from "./InternalHero.astro";
import FoodMenuContent from "./FoodMenuContent.astro";
import WineMenuSection from "./WineMenuSection.astro";
import { getTranslation, languages, localizedPath, type Language } from "../i18n/config";
import { wineCategories, type CartaSection } from "../data/cartas";
import { getFoodMenu, localize } from "../data/food-menus";
import { SITE_URL } from "../data/site";
import { breadcrumbLabels, getMenuSectionSeo, languageTagByCode } from "../config/seo";

interface Props { lang: Language; section: CartaSection }
const { lang, section } = Astro.props;
const t = getTranslation(lang);
const cartaPath = localizedPath(lang, "menu");
const canonicalPath = `${cartaPath}${section.id}/`;
const sectionLanguagePaths = Object.fromEntries(
  languages.map((code) => [code, `${localizedPath(code, "menu")}${section.id}/`]),
) as Record<Language, string>;

const wineSectionCopy: Record<Language, { title: string; lead: string }> = {
  es: { title: "Carta de vinos", lead: "Una selección pensada para acompañar brunch, sobremesas y noches con carácter." },
  ca: { title: "Carta de vins", lead: "Una selecció pensada per acompanyar brunch, sobretaules i nits amb caràcter." },
  en: { title: "Wine list", lead: "A selection designed for brunch, lingering tables and evenings with character." },
  fr: { title: "Carte des vins", lead: "Une sélection pensée pour accompagner brunch, longues tables et soirées de caractère." },
  de: { title: "Weinkarte", lead: "Eine Auswahl für Brunch, lange Tischmomente und Abende mit Charakter." },
  zh: { title: "葡萄酒单", lead: "为早午餐、悠长聚餐和富有格调的夜晚精心挑选。" },
  nl: { title: "Wijnkaart", lead: "Een selectie voor brunch, lange tafelmomenten en avonden met karakter." },
  it: { title: "Carta dei vini", lead: "Una selezione pensata per accompagnare brunch, tavolate lente e serate di carattere." },
};

const foodMenu = section.id === "vinos" ? undefined : getFoodMenu(section.id);
if (section.id !== "vinos" && !foodMenu) throw new Error(`Unknown food menu: ${section.id}`);
const localizedSection = section.id === "vinos"
  ? wineSectionCopy[lang]
  : { title: localize(foodMenu!.title, lang), lead: localize(foodMenu!.lead, lang) };
const seo = getMenuSectionSeo(lang, localizedSection.title, localizedSection.lead);
const breadcrumbs = [
  { name: breadcrumbLabels[lang].home, href: localizedPath(lang) },
  { name: breadcrumbLabels[lang].menu, href: cartaPath },
  { name: localizedSection.title, href: canonicalPath },
];

const offerForPrice = (price: string) => {
  const match = price.trim().match(/^(\d+),(\d{2})€$/);
  return match ? {
    "@type": "Offer",
    price: `${match[1]}.${match[2]}`,
    priceCurrency: "EUR",
  } : undefined;
};

const menuSections = section.id === "vinos"
  ? [{
      "@type": "MenuSection",
      name: localizedSection.title,
      hasMenuItem: wineCategories.flatMap((category) => category.wines.map((wine) => ({
        "@type": "MenuItem",
        name: wine.name,
        description: wine.note,
      }))),
    }]
  : foodMenu!.categories.map((category) => ({
      "@type": "MenuSection",
      name: localize(category.title, lang),
      ...(category.note ? { description: localize(category.note, lang) } : {}),
      hasMenuItem: category.items.map((item) => {
        const offer = offerForPrice(item.price);
        return {
          "@type": "MenuItem",
          name: localize(item.name, lang),
          ...(item.description ? { description: localize(item.description, lang) } : {}),
          ...(offer ? { offers: offer } : {}),
        };
      }),
    }));

const menuSchema = {
  "@type": "Menu",
  "@id": new URL(`${canonicalPath}#menu`, SITE_URL).toString(),
  name: localizedSection.title,
  description: localizedSection.lead,
  url: new URL(canonicalPath, SITE_URL).toString(),
  inLanguage: languageTagByCode[lang],
  hasMenuSection: menuSections,
};
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  lang={lang}
  page="menu"
  canonicalPath={canonicalPath}
  languagePaths={sectionLanguagePaths}
  image={section.image}
  schemaType="CollectionPage"
  schema={menuSchema}
  breadcrumbs={breadcrumbs}
>
  {section.id !== "vinos" && (
    <InternalHero
      eyebrow={localize(foodMenu!.kicker, lang)}
      title={localize(foodMenu!.title, lang)}
      lead={localize(foodMenu!.lead, lang)}
      image={foodMenu!.image}
      alt={localize(foodMenu!.alt, lang)}
      variant="menu"
    />
  )}

  {section.id === "vinos" ? (
    <WineMenuSection lang={lang} backLabel={t.menu.title} />
  ) : (
    <FoodMenuContent lang={lang} menuId={section.id} />
  )}
</BaseLayout>
