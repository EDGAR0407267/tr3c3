---
import { type Language } from "../i18n/config";
import { CONTACT_PHONE } from "../data/site";
import "../styles/action-system.css";

interface Props { lang: Language }

const { lang } = Astro.props;
const copyByLanguage: Record<Language, { call: string; callAria: string }> = {
  es: { call: "Llamar", callAria: "Llamar a TR3C3" },
  ca: { call: "Trucar", callAria: "Trucar a TR3C3" },
  en: { call: "Call", callAria: "Call TR3C3" },
  fr: { call: "Appeler", callAria: "Appeler TR3C3" },
  de: { call: "Anrufen", callAria: "TR3C3 anrufen" },
  zh: { call: "致电", callAria: "致电 TR3C3" },
  nl: { call: "Bellen", callAria: "Bel TR3C3" },
  it: { call: "Chiama", callAria: "Chiama TR3C3" },
};
const copy = copyByLanguage[lang] ?? copyByLanguage.es;
const phoneHref = CONTACT_PHONE ? `tel:${CONTACT_PHONE.replace(/[^\d+]/g, "")}` : undefined;
---

{phoneHref && (
  <a class="floating-call" href={phoneHref} aria-label={`${copy.callAria}: ${CONTACT_PHONE}`} data-floating-call>
    <span class="floating-call__label" aria-hidden="true">{copy.call}</span>
    <span class="floating-call__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M7.2 3.8 4.8 5.4c-.8.6-.5 2.5.6 4.8 1.6 3.2 4.2 5.9 7.5 7.8 2.5 1.4 4.6 1.7 5.3.8l1.7-2.6-4.2-2.3-1.8 1.7c-2.1-1.1-4.8-3.8-5.8-5.9L9.8 8z"/></svg>
    </span>
  </a>
)}
