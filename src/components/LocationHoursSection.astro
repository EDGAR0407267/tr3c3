---
import {
  GOOGLE_MAPS_EMBED_URL,
  GOOGLE_MAPS_URL,
  LOCATION_ADDRESS_LINES,
  LOCATION_CONTEXT,
  WEEKDAY_HOURS,
} from "../data/location";
import { BUSINESS_ADDRESS, BUSINESS_SHORT_NAME, CONTACT_PHONE } from "../data/site";
import { locationSectionCopy } from "../data/location-copy";
import { localizedPath, type Language } from "../i18n/config";
import ContextualCta from "./ContextualCta.astro";
import locationHoursStylesHref from "../styles/location-hours.css?url";
import DeferredStyles from "./DeferredStyles.astro";

interface Props { lang: Language }
const { lang } = Astro.props;

const copy = locationSectionCopy[lang];

const menuPath = localizedPath(lang, "menu");
const callCta: Record<Language, string> = {
  es: "Llamar al restaurante",
  ca: "Trucar al restaurant",
  en: "Call the restaurant",
  fr: "Appeler le restaurant",
  de: "Restaurant anrufen",
  zh: "致电餐厅",
  nl: "Bel het restaurant",
  it: "Chiama il ristorante",
};
const phoneHref = CONTACT_PHONE ? `tel:${CONTACT_PHONE.replace(/[^\d+]/g, "")}` : undefined;
const addressLabel = `${BUSINESS_ADDRESS.streetAddress}, ${BUSINESS_ADDRESS.postalCode} ${BUSINESS_ADDRESS.addressLocality}, ${BUSINESS_ADDRESS.addressRegion}`;
const [weekdayOpen, weekdayClose] = WEEKDAY_HOURS.time.split("–");
---

<DeferredStyles href={locationHoursStylesHref} />
<section id="visit" class="home-visit-section reveal" data-reveal aria-labelledby="home-visit-title">
  <span class="home-visit-section__curve" aria-hidden="true"></span>
  <span class="home-visit-section__bean home-visit-section__bean--one" aria-hidden="true"></span>
  <span class="home-visit-section__bean home-visit-section__bean--two" aria-hidden="true"></span>

  <div class="tr-shell home-visit-section__grid">
    <div class="home-visit-section__copy reveal" data-reveal>
      <p class="editorial-kicker">{copy.kicker}</p>
      <h2 id="home-visit-title">{copy.title}</h2>
      <p class="home-visit-section__lead">{copy.lead}</p>
      <p class="home-visit-section__phrase">{copy.phrase}</p>

      <address class="home-visit-address" aria-label={addressLabel}>
        <strong>{BUSINESS_SHORT_NAME}</strong>
        <span>{LOCATION_ADDRESS_LINES[0]}</span>
        <span>{LOCATION_ADDRESS_LINES[1]}</span>
        <small>{LOCATION_CONTEXT}</small>
      </address>

      <div class="home-visit-section__actions" aria-label="TR3C3 visit actions">
        <a class="tr-button tr-button--primary" href={GOOGLE_MAPS_URL} target="_blank" rel="noopener noreferrer">{copy.directions}</a>
        <a class="tr-button tr-button--secondary" href={menuPath}>{copy.menu}</a>
      </div>

      <ul class="home-visit-details" aria-label="TR3C3 experience details">
        {copy.details.map((detail) => <li>{detail}</li>)}
      </ul>
    </div>

    <div class="home-visit-section__visual">
      <figure class="home-visit-map reveal" data-reveal>
        <span class="home-visit-map__badge" aria-hidden="true">{BUSINESS_SHORT_NAME}</span>
        <div
          class="home-visit-map__frame tr-map-facade"
          data-src={GOOGLE_MAPS_EMBED_URL}
          data-map-facade
          data-title={copy.mapTitle}
          data-referrerpolicy="no-referrer-when-downgrade"
          role="img"
          aria-label={copy.mapTitle}
        >
          <strong>TR3C3</strong>
          <span>MIAMI PLATJA · COSTA DAURADA</span>
        </div>
        <figcaption>
          <strong>{BUSINESS_SHORT_NAME}</strong>
          <address>{addressLabel}</address>
        </figcaption>
      </figure>

      <article class="home-visit-hours reveal" data-reveal aria-labelledby="home-visit-hours-title">
        <p class="editorial-kicker">{copy.hours}</p>
        <h3 id="home-visit-hours-title">{copy.phrase}</h3>
        <div class="home-visit-hours__list">
          <div class="home-visit-hours__row">
            <span>{copy.everyday}</span>
            <strong><time datetime={weekdayOpen}>{weekdayOpen}</time> — <time datetime={weekdayClose}>{weekdayClose}</time></strong>
          </div>
        </div>
        {phoneHref && <ContextualCta className="home-visit-hours__call" href={phoneHref} label={callCta[lang]} ariaLabel={`${callCta[lang]}: ${CONTACT_PHONE}`} tone="copper" />}
      </article>
    </div>
  </div>
</section>