---
import { type Language } from "../i18n/config";

interface Props { lang: Language }
const { lang } = Astro.props;

const copy = lang === "es" ? {
  kicker: "Miami Platja",
  title: "Speciality Coffee & Brunch",
  lead: "El mejor café de especialidad y brunch mediterráneo de Miami Platja, en una carta que enamora a la primera.",
} : {
  kicker: "Miami Platja",
  title: "Speciality Coffee & Brunch",
  lead: "The best specialty coffee and Mediterranean brunch in Miami Platja, in a menu you'll fall for at first sight.",
};

const images = [
  {
    className: "scroll-collage__item--main",
    src: "/images/interior-cafe.webp",
    alt: "Interior cálido de TR3C3 con ambiente mediterráneo",
    width: "clamp(22rem, 48vw, 48rem)",
    ratio: "4 / 3",
    radius: "2.7rem 2.7rem 1.55rem 2.2rem",
    x0: 0, y0: -2, s0: .78, r0: -.8, o0: .96,
    x1: 0, y1: -1, s1: 1.28, r1: 0, o1: 1,
    x2: -5, y2: -15, s2: 1.03, r2: -.5, o2: .82,
  },
  {
    className: "scroll-collage__item--left",
    src: "/images/specialty-coffee.webp",
    alt: "Café de especialidad preparado en TR3C3",
    width: "clamp(12rem, 19vw, 19rem)",
    ratio: "3 / 4",
    radius: "2.2rem 1.35rem 2.4rem 1.8rem",
    x0: -48, y0: -6, s0: .76, r0: -4, o0: .56,
    x1: -38, y1: -10, s1: .98, r1: -2.2, o1: .92,
    x2: -58, y2: -25, s2: .74, r2: -6, o2: .35,
  },
  {
    className: "scroll-collage__item--right",
    src: "/images/brunch-table.webp",
    alt: "Mesa de brunch mediterráneo en TR3C3",
    width: "clamp(14rem, 23vw, 24rem)",
    ratio: "5 / 4",
    radius: "1.7rem 2.7rem 1.9rem 2.35rem",
    x0: 48, y0: 9, s0: .68, r0: 3.5, o0: .54,
    x1: 36, y1: 4, s1: .96, r1: 1.5, o1: .9,
    x2: 57, y2: -12, s2: .82, r2: 5, o2: .4,
  },
  {
    className: "scroll-collage__item--drink",
    src: "/images/drinks/matcha-orange.webp",
    alt: "Matcha con naranja servido en TR3C3",
    width: "clamp(9rem, 15vw, 15rem)",
    ratio: "3 / 4",
    radius: "1.55rem 2rem 1.35rem 2.25rem",
    x0: 26, y0: -33, s0: .6, r0: -3, o0: .38,
    x1: 31, y1: -26, s1: .93, r1: -1, o1: .86,
    x2: 20, y2: -44, s2: .62, r2: -5, o2: .3,
  },
  {
    className: "scroll-collage__item--pastry scroll-collage__item--desktop-only",
    src: "/images/croissant-coffee.webp",
    alt: "Croissant y café sobre mesa clara en TR3C3",
    width: "clamp(11rem, 17vw, 17rem)",
    ratio: "4 / 5",
    radius: "2.4rem 1.65rem 2rem 1.3rem",
    x0: -27, y0: 31, s0: .58, r0: 3.2, o0: .36,
    x1: -31, y1: 24, s1: .92, r1: 1.2, o1: .78,
    x2: -18, y2: 43, s2: .66, r2: 4.5, o2: .28,
  },
  {
    className: "scroll-collage__item--evening scroll-collage__item--desktop-only",
    src: "/images/kitchen-evening.webp",
    alt: "Ambiente de tarde y cocina cuidada en TR3C3",
    width: "clamp(13rem, 20vw, 21rem)",
    ratio: "16 / 11",
    radius: "1.4rem 2.25rem 2rem 1.8rem",
    x0: 3, y0: 38, s0: .58, r0: -2.4, o0: .34,
    x1: 5, y1: 31, s1: .86, r1: -.7, o1: .7,
    x2: 24, y2: 43, s2: .64, r2: 2.8, o2: .25,
  },
  {
    className: "scroll-collage__item--cold",
    src: "/images/drinks/iced-latte.webp",
    alt: "Iced latte de TR3C3 sobre fondo cálido",
    width: "clamp(9rem, 14vw, 14rem)",
    ratio: "3 / 4",
    radius: "2rem 1.4rem 2.25rem 1.55rem",
    x0: -5, y0: -39, s0: .46, r0: 4, o0: .28,
    x1: -13, y1: -33, s1: .72, r1: 2.2, o1: .64,
    x2: -35, y2: -45, s2: .5, r2: 7, o2: .18,
  },
