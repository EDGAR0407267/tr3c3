---
import BaseLayout from "../layouts/BaseLayout.astro";
import InternalHero from "./InternalHero.astro";
import Img from "./Img.astro";
import { localSeoPages, type LocalSeoSlug } from "../data/local-seo-pages";
import { GOOGLE_MAPS_URL, HOURS_SUMMARY, LOCATION_ADDRESS_LINES } from "../data/location";
import { BUSINESS_NAME, CONTACT_EMAIL, SITE_URL } from "../data/site";

interface Props { slug: LocalSeoSlug }
const { slug } = Astro.props;
const page = localSeoPages[slug];
const canonicalPath = `/${slug}/`;
const canonical = new URL(canonicalPath, SITE_URL).toString();
const relatedPages = page.related.map((relatedSlug) => ({ slug: relatedSlug, ...localSeoPages[relatedSlug] }));
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": `${canonical}#article`,
      headline: page.h1,
      description: page.description,
      image: new URL(page.heroImage, SITE_URL).toString(),
      inLanguage: "es",
      mainEntityOfPage: canonical,
      author: { "@id": `${SITE_URL}/#local-business` },
      publisher: { "@id": `${SITE_URL}/#local-business` },
      about: { "@id": `${SITE_URL}/#local-business` },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Inicio", item: `${SITE_URL}/es/` },
        { "@type": "ListItem", position: 2, name: "Guías locales", item: `${SITE_URL}/es/#guias-locales` },
        { "@type": "ListItem", position: 3, name: page.h1, item: canonical },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: page.faq.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
      })),
    },
  ],
};
---

<BaseLayout
  title={page.title}
  description={page.description}
  lang="es"
  canonicalPath={canonicalPath}
  pageType="article"
  image={page.heroImage}
  imageAlt={page.heroAlt}
  schema={schema}
  localizedAlternates={false}
  preloadImage
>
  <article class="local-seo-page">
    <nav class="local-breadcrumbs tr-shell" aria-label="Migas de pan">
      <ol>
        <li><a href="/es/">Inicio</a></li>
        <li><span>Guías locales</span></li>
        <li aria-current="page"><span>{page.h1}</span></li>
      </ol>
    </nav>

    <InternalHero
      eyebrow="Guía local / Miami Platja"
      title={page.h1}
      lead={page.intro}
      image={page.heroImage}
      alt={page.heroAlt}
      variant="seo"
      primaryHref="/es/carta/"
      primaryLabel="Ver la carta"
    />

    <section id="contenido" class="local-highlights" aria-label="Claves de la experiencia">
      <div class="tr-shell">
        {page.highlights.map((highlight, index) => <p><span>0{index + 1}</span>{highlight}</p>)}
      </div>
    </section>

    <div class="tr-shell local-content-layout">
      <div class="local-content">
        {page.sections.map((section, index) => (
          <section class="local-content__section reveal" data-reveal>
            <p class="editorial-kicker">{section.eyebrow}</p>
            <h2>{section.title}</h2>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {index === 1 && <figure><Img src="/images/interior-cafe.webp" alt={`Interior cuidado de ${BUSINESS_NAME} en Miami Platja`} width={1200} height={900} /></figure>}
          </section>
        ))}
      </div>

      <aside class="local-visit-card" aria-label="Información para visitar TR3C3">
        <p class="editorial-kicker">Visita TR3C3</p>
        <h2>Miami Platja,<br />Tarragona.</h2>
        <address>{LOCATION_ADDRESS_LINES.map((line) => <>{line}<br /></>)}</address>
        <p>{HOURS_SUMMARY}</p>
        <div>
          <a class="tr-button tr-button--primary" href="/es/carta/">Ver carta</a>
          <a class="tr-button tr-button--secondary" href={GOOGLE_MAPS_URL} target="_blank" rel="noopener noreferrer">Cómo llegar</a>
          <a class="tr-button tr-button--secondary" href="/es/contacto/">Contacto</a>
        </div>
        <a class="local-visit-card__email" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
      </aside>
    </div>

    <section class="editorial-section seo-faq local-faq reveal" data-reveal>
      <div class="tr-shell seo-faq__grid">
        <div><p class="editorial-kicker">Preguntas frecuentes</p><h2>Antes de venir.</h2></div>
        <div>{page.faq.map((item, index) => <details><summary><span>0{index + 1}</span>{item.question}<b aria-hidden="true">+</b></summary><p>{item.answer}</p></details>)}</div>
      </div>
    </section>

    <nav class="seo-related" aria-label="Guías locales relacionadas">
      <div class="tr-shell">
        <p class="editorial-kicker">Más guías locales</p>
        {relatedPages.map((item) => <a href={`/${item.slug}/`}>{item.h1}<span aria-hidden="true">→</span></a>)}
      </div>
    </nav>

    <section class="editorial-final-cta editorial-final-cta--copper reveal" data-reveal>
      <div class="tr-shell">
        <p class="editorial-kicker">TR3C3 Coffee & Brunch</p>
        <h2>{page.ctaTitle}</h2>
        <div class="editorial-actions">
          <a class="tr-button tr-button--light" href="/es/carta/">Ver la carta</a>
          <a class="tr-button tr-button--light" href={GOOGLE_MAPS_URL} target="_blank" rel="noopener noreferrer">Cómo llegar</a>
          <a class="tr-button tr-button--light" href="/es/contacto/">Contacto</a>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>
