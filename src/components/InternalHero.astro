---
import "../styles/editorial-pages.css";
interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  secondary?: string;
  image: string;
  alt: string;
  variant?: "about" | "team" | "menu" | "contact" | "seo" | "essence";
  primaryHref?: string;
  primaryLabel?: string;
}
const {
  eyebrow, title, lead, secondary, image, alt, variant = "about",
  primaryHref, primaryLabel,
} = Astro.props;
// Los enlaces externos (p. ej. Google Maps) se abren en una pestaña nueva de
// forma segura; los internos conservan la navegación en la misma pestaña.
const primaryIsExternal = typeof primaryHref === "string" && /^https?:\/\//.test(primaryHref);

const dot = image.lastIndexOf(".");
const imageBase = dot > 0 ? image.slice(0, dot) : image;
const imageExt = dot > 0 ? image.slice(dot) : "";
const imageSrcset = `${imageBase}-480${imageExt} 480w, ${imageBase}-640${imageExt} 640w, ${imageBase}-828${imageExt} 828w, ${imageBase}-1080${imageExt} 1080w, ${image} 1600w`;
const imageAvifSrcset = `${imageBase}-480.avif 480w, ${imageBase}-640.avif 640w, ${imageBase}-828.avif 828w, ${imageBase}-1080.avif 1080w, ${imageBase}.avif 1600w`;
const imageSizes = "(max-width: 760px) 100vw, (max-width: 1200px) 100vw, 1600px";
---

<header class:list={["editorial-hero", `editorial-hero--${variant}`]}>
  <picture class="pic">
    <source type="image/avif" srcset={imageAvifSrcset} sizes={imageSizes} />
    <img class="editorial-hero__image" src={image} srcset={imageSrcset} sizes={imageSizes} alt={alt} width="1600" height="900" loading="eager" decoding="async" fetchpriority="high" />
  </picture>
  <div class="editorial-hero__veil" aria-hidden="true"></div>
  <div class="tr-shell editorial-hero__content">
    <p class="editorial-kicker">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="editorial-hero__lead">{lead}</p>
    {secondary && <p class="editorial-hero__lead editorial-hero__lead--secondary">{secondary}</p>}
    {primaryHref && primaryLabel && <a class="editorial-link editorial-link--light" href={primaryHref} target={primaryIsExternal ? "_blank" : undefined} rel={primaryIsExternal ? "noopener noreferrer" : undefined}>{primaryLabel}<span aria-hidden="true">&#8599;</span></a>}
  </div>
  <a class="editorial-hero__scroll" href="#contenido"><span></span>Scroll</a>
</header>