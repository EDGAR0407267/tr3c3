---
import { type Language } from "../i18n/config";
import { INSTAGRAM_HANDLE, INSTAGRAM_URL } from "../data/site";

interface Props { lang: Language }
const { lang } = Astro.props;

const tiles = [
  { src: "/images/carousel-cafes-latte-cappuccino.webp", alt: "Dos cafés de especialidad con arte latte sobre una tabla de madera en TR3C3" },
  { src: "/images/carousel-cheesecake.webp", alt: "Porción de tarta de queso cremosa con flores comestibles en TR3C3" },
  { src: "/images/carousel-cocteles.webp", alt: "Dos cócteles rojos con lima y hielo en la terraza de TR3C3" },
  { src: "/images/carousel-sandwich-brioche.webp", alt: "Sándwiches de brioche a la plancha con flores comestibles en TR3C3" },
  { src: "/images/carousel-brioche-tartar.webp", alt: "Brioche con tartar de ternera y micromezclum en TR3C3" },
  { src: "/images/carousel-torrija-helado.webp", alt: "Torrija con helado, chocolate y frutos secos en TR3C3" },
  { src: "/images/carousel-tostadas-salmon.webp", alt: "Tostada de salmón ahumado y aguacate en TR3C3" },
  { src: "/images/carousel-cafe-latte-art.webp", alt: "Café con arte latte servido en bandeja de madera en TR3C3" },
  { src: "/images/carousel-sandwiches-plato-rosa.webp", alt: "Sándwiches triangulares a la plancha en plato rosa en TR3C3" },
];

const labels: Record<Language, { kicker: string; title: string; lead: string }> = {
  es: { kicker: "Síguenos en redes", title: "Miami Platja sabe a café", lead: "Cada plato, cada latte y cada rincón. Así se vive TR3C3 día a día. Síguenos y no te pierdas nada." },
  ca: { kicker: "Segueix-nos a les xarxes", title: "Miami Platja sap a cafè", lead: "Cada plat, cada latte i cada racó. Així es viu TR3C3 dia a dia. Segueix-nos i no et perdis res." },
  en: { kicker: "Follow us", title: "Miami Platja tastes of coffee", lead: "Every plate, every latte and every corner. This is TR3C3, day by day. Follow us and don't miss a thing." },
  fr: { kicker: "Suivez‑nous", title: "Miami Platja a un goût de café", lead: "Chaque assiette, chaque latte et chaque recoin. TR3C3 au quotidien. Suivez‑nous pour ne rien manquer." },
  de: { kicker: "Folge uns", title: "Miami Platja schmeckt nach Kaffee", lead: "Jeder Teller, jeder Latte, jede Ecke. So lebt TR3C3, Tag für Tag. Folge uns und verpasse nichts." },
  zh: { kicker: "关注我们", title: "Miami Platja 满是咖啡香", lead: "每一道餐点、每一杯拿铁、每一个角落，这就是日常的 TR3C3。关注我们，精彩不错过。" },
  nl: { kicker: "Volg ons", title: "Miami Platja smaakt naar koffie", lead: "Elk bord, elke latte en elk hoekje. Zo leeft TR3C3, dag na dag. Volg ons en mis niets." },
  it: { kicker: "Seguici", title: "Miami Platja sa di caffè", lead: "Ogni piatto, ogni latte e ogni angolo. TR3C3, giorno dopo giorno. Seguici e non perderti nulla." },
};
const l = labels[lang] ?? labels.es;
const handle = INSTAGRAM_HANDLE ?? "@tr3c3";
const carouselSourceWidths: Record<string, number> = {
  "/images/carousel-cafes-latte-cappuccino.webp": 1200,
  "/images/carousel-cheesecake.webp": 900,
  "/images/carousel-cocteles.webp": 900,
  "/images/carousel-sandwich-brioche.webp": 900,
  "/images/carousel-brioche-tartar.webp": 900,
  "/images/carousel-torrija-helado.webp": 900,
  "/images/carousel-tostadas-salmon.webp": 900,
  "/images/carousel-cafe-latte-art.webp": 675,
  "/images/carousel-sandwiches-plato-rosa.webp": 900,
};
const responsiveSrcset = (src: string, ext = ".webp") => {
  const sourceWidth = carouselSourceWidths[src] ?? 900;
  const base = src.replace(/\.webp$/, "");
  const variants = [320, 480, 560, 640, 828]
    .filter((width) => width < sourceWidth)
    .map((width) => base + "-" + width + ext + " " + width + "w");
  return [...variants, base + ext + " " + sourceWidth + "w"].join(", ");
};
---
<section class="tr3c3-gallery reveal" data-reveal data-loop-motion aria-label={l.title}>
  <span class="tr3c3-gallery__brush tr3c3-gallery__brush--one" aria-hidden="true"></span>
  <span class="tr3c3-gallery__brush tr3c3-gallery__brush--two" aria-hidden="true"></span>
  <div class="tr-shell">
    <div class="tr3c3-gallery__head">
      <div>
        <p class="editorial-kicker">{l.kicker}</p>
        <h2>{l.title}</h2>
        <p class="tr3c3-gallery__lead">{l.lead}</p>
      </div>
      <div class="tr3c3-gallery__social">
        {INSTAGRAM_URL && (
          <a class="tr3c3-gallery__handle" href={INSTAGRAM_URL} target="_blank" rel="me noopener noreferrer" aria-label={`Instagram ${handle}`}>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2.5" y="2.5" width="19" height="19" rx="5.5" />
              <circle cx="12" cy="12" r="4.2" />
              <circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none" />
            </svg>
            <span>{handle}</span>
          </a>
        )}
      </div>
    </div>
  </div>

  <div class="tr3c3-gallery__rail">
    <div class="tr3c3-gallery__track">
      {[...tiles, ...tiles].map((tile, index) => {
        const clone = index >= tiles.length;
        const inner = (
          <Fragment>
            <picture class="pic">
              <source type="image/avif" srcset={responsiveSrcset(tile.src, ".avif")} sizes="(max-width: 650px) 68vw, (max-width: 1280px) 24vw, 19rem" />
              <img src={tile.src} srcset={responsiveSrcset(tile.src)} sizes="(max-width: 650px) 68vw, (max-width: 1280px) 24vw, 19rem" alt={clone ? "" : tile.alt} width="640" height="800" loading="lazy" decoding="async" />
            </picture>
            <span class="tr3c3-gallery__veil" aria-hidden="true"></span>
            <span class="tr3c3-gallery__tag" aria-hidden="true">{handle}</span>
          </Fragment>
        );
        const ariaHidden = clone ? "true" : undefined;
        const tabindex = clone ? -1 : undefined;
        return INSTAGRAM_URL ? (
          <a class="tr3c3-gallery__tile" href={INSTAGRAM_URL} target="_blank" rel="me noopener noreferrer" aria-hidden={ariaHidden} tabindex={tabindex}>{inner}</a>
        ) : (
          <figure class="tr3c3-gallery__tile" aria-hidden={ariaHidden}>{inner}</figure>
        );
      })}
    </div>
  </div>
</section>
