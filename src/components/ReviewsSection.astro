---
import { type Language } from "../i18n/config";
import DeferredStyles from "./DeferredStyles.astro";
import reviewsStylesHref from "../styles/reviews.css?url";
import { reviews, GOOGLE_RATING, GOOGLE_REVIEWS_URL } from "../data/reviews";
import { GOOGLE_MAPS_URL } from "../data/location";
import ContextualCta from "./ContextualCta.astro";

interface Props { lang: Language }
const { lang } = Astro.props;

// Copys por idioma. El título/subtítulo siguen la petición del negocio.
const labels: Record<Language, {
  kicker: string; title: string; lead: string;
  badgeTitle: string; based: string; cta: string; prev: string; next: string; goto: string;
}> = {
  es: {
    kicker: "Reseñas reales",
    title: "Lo que dicen de TR3C3",
    lead: "Experiencias reales de quienes ya han disfrutado nuestro brunch, café de especialidad y cocina mediterránea.",
    badgeTitle: "Google Reviews",
    based: "Basado en reseñas reales de Google",
    cta: "Ver más reseñas en Google",
    prev: "Reseña anterior", next: "Siguiente reseña", goto: "Ir a la reseña",
  },
  ca: {
    kicker: "Ressenyes reals",
    title: "El que diuen de TR3C3",
    lead: "Experiències reals de qui ja ha gaudit del nostre brunch, cafè d’especialitat i cuina mediterrània.",
    badgeTitle: "Google Reviews",
    based: "Basat en ressenyes reals de Google",
    cta: "Veure més ressenyes a Google",
    prev: "Ressenya anterior", next: "Ressenya següent", goto: "Anar a la ressenya",
  },
  en: {
    kicker: "Real reviews",
    title: "What people say about TR3C3",
    lead: "Real experiences from those who have already enjoyed our brunch, specialty coffee and Mediterranean cooking.",
    badgeTitle: "Google Reviews",
    based: "Based on real Google reviews",
    cta: "See more reviews on Google",
    prev: "Previous review", next: "Next review", goto: "Go to review",
  },
  fr: {
    kicker: "Avis réels",
    title: "Ce que l’on dit de TR3C3",
    lead: "Des expériences réelles de ceux qui ont déjà savouré notre brunch, notre café de spécialité et notre cuisine méditerranéenne.",
    badgeTitle: "Google Reviews",
    based: "Basé sur de vrais avis Google",
    cta: "Voir plus d’avis sur Google",
    prev: "Avis précédent", next: "Avis suivant", goto: "Aller à l’avis",
  },
  de: {
    kicker: "Echte Bewertungen",
    title: "Was man über TR3C3 sagt",
    lead: "Echte Erfahrungen von Gästen, die unseren Brunch, Spezialitätenkaffee und die mediterrane Küche bereits genossen haben.",
    badgeTitle: "Google Reviews",
    based: "Basierend auf echten Google-Bewertungen",
    cta: "Mehr Bewertungen auf Google ansehen",
    prev: "Vorherige Bewertung", next: "Nächste Bewertung", goto: "Zur Bewertung",
  },
  zh: {
    kicker: "真实评价",
    title: "大家对 TR3C3 的评价",
    lead: "来自已经品尝过我们早午餐、精品咖啡与地中海料理的客人的真实体验。",
    badgeTitle: "Google Reviews",
    based: "基于真实的 Google 评价",
    cta: "在 Google 查看更多评价",
    prev: "上一条评价", next: "下一条评价", goto: "前往评价",
  },
  nl: {
    kicker: "Echte reviews",
    title: "Wat men zegt over TR3C3",
    lead: "Echte ervaringen van wie al genoot van onze brunch, specialty koffie en mediterrane keuken.",
    badgeTitle: "Google Reviews",
    based: "Gebaseerd op echte Google-reviews",
    cta: "Meer reviews op Google bekijken",
    prev: "Vorige review", next: "Volgende review", goto: "Ga naar review",
  },
  it: {
    kicker: "Recensioni reali",
    title: "Cosa dicono di TR3C3",
    lead: "Esperienze reali di chi ha già gustato il nostro brunch, il caffè speciale e la cucina mediterranea.",
    badgeTitle: "Google Reviews",
    based: "Basato su recensioni reali di Google",
    cta: "Vedi altre recensioni su Google",
    prev: "Recensione precedente", next: "Recensione successiva", goto: "Vai alla recensione",
  },
};
const l = labels[lang] ?? labels.es;
const visitCta: Record<Language, string> = {
  es: "Ven a conocernos",
  ca: "Vine a conèixer-nos",
  en: "Come and meet us",
  fr: "Venez nous rencontrer",
  de: "Komm uns besuchen",
  zh: "欢迎来认识我们",
  nl: "Kom kennismaken",
  it: "Vieni a conoscerci",
};

const initialOf = (name: string) => (name.trim().charAt(0) || "?").toUpperCase();
const gmapsUrl = GOOGLE_REVIEWS_URL;
---
<DeferredStyles href={reviewsStylesHref} />
<section class="reviews reveal" data-reveal aria-labelledby="reviews-title">
  <span class="reviews__steam reviews__steam--left" aria-hidden="true"></span>
  <span class="reviews__steam reviews__steam--right" aria-hidden="true"></span>
  <span class="reviews__wash reviews__wash--one" aria-hidden="true"></span>
  <span class="reviews__wash reviews__wash--two" aria-hidden="true"></span>
  <span class="reviews__leaf reviews__leaf--one" aria-hidden="true">
    <svg viewBox="0 0 40 90"><path d="M20 2C6 20 6 46 20 88M20 88C34 46 34 20 20 2M8 30h24M6 50h28M9 68h22" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
  </span>
  <span class="reviews__leaf reviews__leaf--two" aria-hidden="true">
    <svg viewBox="0 0 40 90"><path d="M20 2C6 20 6 46 20 88M20 88C34 46 34 20 20 2M8 30h24M6 50h28M9 68h22" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
  </span>

  <div class="tr-shell reviews__inner">
    <header class="reviews__head">
      <p class="editorial-kicker">{l.kicker}</p>
      <h2 id="reviews-title">{l.title}</h2>
      <p class="reviews__lead">{l.lead}</p>
    </header>

    <aside class="gbadge" aria-label={l.badgeTitle}>
      <div class="gbadge__brand">
        <span class="gbadge__logo" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5a5.6 5.6 0 0 1-2.4 3.6v3h3.9c2.3-2.1 3.5-5.2 3.5-8.8z"/><path fill="#34A853" d="M12 24c3.2 0 6-1.1 8-2.9l-3.9-3c-1.1.7-2.5 1.2-4.1 1.2-3.1 0-5.8-2.1-6.8-5H1.2v3.1A12 12 0 0 0 12 24z"/><path fill="#FBBC05" d="M5.2 14.3a7.2 7.2 0 0 1 0-4.6V6.6H1.2a12 12 0 0 0 0 10.8l4-3.1z"/><path fill="#EA4335" d="M12 4.8c1.8 0 3.3.6 4.6 1.8l3.4-3.4A12 12 0 0 0 12 0 12 12 0 0 0 1.2 6.6l4 3.1c1-2.9 3.7-4.9 6.8-4.9z"/></svg>
        </span>
        <span class="gbadge__name">{l.badgeTitle}</span>
      </div>
      <div class="gbadge__score">
        <strong class="gbadge__value">{GOOGLE_RATING.average}</strong>
        <span class="gbadge__outof">/ 5</span>
      </div>
      <span class="stars stars--gold" aria-hidden="true">
        {Array.from({ length: 5 }).map(() => (
          <svg viewBox="0 0 20 20"><path d="M10 1.6l2.47 5.01 5.53.8-4 3.9.94 5.5L10 14.2l-4.94 2.6.94-5.5-4-3.9 5.53-.8z" /></svg>
        ))}
      </span>
      <p class="gbadge__based">{l.based}{GOOGLE_RATING.count ? ` · ${GOOGLE_RATING.count}` : ""}</p>
      <a class="gbadge__cta" href={gmapsUrl} target="_blank" rel="noopener noreferrer">
        {l.cta}<span aria-hidden="true"> ↗</span>
      </a>
    </aside>

    <div class="reviews__carousel" data-carousel role="region" aria-label={l.title}>
      <button type="button" class="reviews__arrow reviews__arrow--prev" data-prev aria-label={l.prev}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>

      <div class="reviews__viewport" data-viewport>
        <ul class="reviews__track" data-track role="list" tabindex="0" aria-label={l.title} aria-live="off">
        {reviews.map((review, index) => (
          <li class="rcard" role="listitem" aria-label={`${index + 1} / ${reviews.length}`}>
            <span class="rcard__quote" aria-hidden="true">”</span>
            <div class="rcard__top">
              <span class="rcard__avatar" aria-hidden="true">{initialOf(review.name)}</span>
              <div class="rcard__who">
                <strong class="rcard__name">{review.name}</strong>
                {review.date && <span class="rcard__date">{review.date}</span>}
              </div>
              <span class="rcard__g" role="img" aria-label="Google" title="Google">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5a5.6 5.6 0 0 1-2.4 3.6v3h3.9c2.3-2.1 3.5-5.2 3.5-8.8z"/><path fill="#34A853" d="M12 24c3.2 0 6-1.1 8-2.9l-3.9-3c-1.1.7-2.5 1.2-4.1 1.2-3.1 0-5.8-2.1-6.8-5H1.2v3.1A12 12 0 0 0 12 24z"/><path fill="#FBBC05" d="M5.2 14.3a7.2 7.2 0 0 1 0-4.6V6.6H1.2a12 12 0 0 0 0 10.8l4-3.1z"/><path fill="#EA4335" d="M12 4.8c1.8 0 3.3.6 4.6 1.8l3.4-3.4A12 12 0 0 0 12 0 12 12 0 0 0 1.2 6.6l4 3.1c1-2.9 3.7-4.9 6.8-4.9z"/></svg>
              </span>
            </div>
            <span class="stars stars--card" role="img" aria-label={`${review.rating} / 5`}>
              {Array.from({ length: review.rating }).map(() => (
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 1.6l2.47 5.01 5.53.8-4 3.9.94 5.5L10 14.2l-4.94 2.6.94-5.5-4-3.9 5.53-.8z" /></svg>
              ))}
            </span>
            <p class="rcard__text">{review.text}</p>
          </li>
        ))}
        </ul>
      </div>

      <button type="button" class="reviews__arrow reviews__arrow--next" data-next aria-label={l.next}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>

    <div class="reviews__dots" data-dots role="group" aria-label={l.goto}></div>
    <p class="sr-only" data-carousel-status aria-live="polite" aria-atomic="true"></p>
    <div class="reviews__visit-cta">
      <ContextualCta href={GOOGLE_MAPS_URL} label={visitCta[lang]} ariaLabel={visitCta[lang]} external tone="copper" />
    </div>
  </div>
</section>


<script>
  // Carrusel infinito sin dependencias: clones visuales, una sola espera de
  // autoplay y gestos Pointer Events que mantienen libre el scroll vertical.
  type CarouselRoot = HTMLElement & { __reviewsCarouselCleanup?: () => void };

  const setup = (root: CarouselRoot) => {
    if (root.__reviewsCarouselCleanup) return;

    const track = root.querySelector<HTMLElement>("[data-track]");
    const viewport = root.querySelector<HTMLElement>("[data-viewport]");
    const prev = root.querySelector<HTMLButtonElement>("[data-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-next]");
    const section = root.closest<HTMLElement>(".reviews");
    const dotsBox = section?.querySelector<HTMLElement>("[data-dots]");
    const status = section?.querySelector<HTMLElement>("[data-carousel-status]");
    if (!track || !viewport || !prev || !next || !dotsBox) return;

    const originals = Array.from(track.children) as HTMLElement[];
    const count = originals.length;
    if (!count) return;

    const controller = new AbortController();
    const { signal } = controller;
    const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
    let reducedMotion = motionQuery.matches;
    // Three cards are visible at most, so two clones per edge cover every
    // seamless transition without cloning the full list.
    const cloneCount = Math.min(2, count);

    const cloneSlide = (slide: HTMLElement) => {
      const clone = slide.cloneNode(true) as HTMLElement;
      clone.dataset.clone = "true";
      clone.setAttribute("aria-hidden", "true");
      clone.removeAttribute("aria-label");
      clone.inert = true;
      return clone;
    };

    const leading = document.createDocumentFragment();
    originals.slice(-cloneCount).forEach((slide) => leading.append(cloneSlide(slide)));
    track.insertBefore(leading, originals[0]);
    const trailing = document.createDocumentFragment();
    originals.slice(0, cloneCount).forEach((slide) => trailing.append(cloneSlide(slide)));
    track.append(trailing);

    const renderedSlides = Array.from(track.children) as HTMLElement[];
    const gotoLabel = dotsBox.getAttribute("aria-label") || "Ir a la reseña";
    const modulo = (value: number, divisor: number) => ((value % divisor) + divisor) % divisor;
    let renderedIndex = cloneCount;
    let logicalIndex = 0;
    let transitioning = false;
    let announceAfterMove = false;
    let autoplayTimer: number | undefined;
    let resizeFrame = 0;
    let resetFrame = 0;
    let focusFrame: number | undefined;
    let inView = !("IntersectionObserver" in window);
    let pointerOver = false;
    let pointerInteracting = false;
    let focusWithin = false;
    let keyboardModality = false;
    let slideOffsets: number[] = [];

    const dots = originals.map((_, index) => {
      const dot = document.createElement("button");
      dot.type = "button";
      dot.className = "reviews__dot";
      dot.setAttribute("aria-label", `${gotoLabel} ${index + 1}`);
      dotsBox.append(dot);
      return dot;
    });

    const syncUi = (announce = false) => {
      logicalIndex = modulo(renderedIndex - cloneCount, count);
      dots.forEach((dot, index) => {
        const active = index === logicalIndex;
        dot.setAttribute("aria-current", active ? "true" : "false");
      });
      if (announce && status) status.textContent = `${gotoLabel} ${logicalIndex + 1} / ${count}`;
    };

    const slideOffset = (index: number) => slideOffsets[index] ?? 0;
    const setTrackPosition = (index: number, animate: boolean) => {
      const transform = `translate3d(${-slideOffset(index)}px, 0, 0)`;
      if (!animate) {
        cancelAnimationFrame(resetFrame);
        track.classList.remove("is-animating", "is-dragging");
        track.classList.add("is-resetting");
        track.style.transform = transform;
        resetFrame = requestAnimationFrame(() => {
          track.classList.remove("is-resetting");
          resetFrame = 0;
        });
        return;
      }
      cancelAnimationFrame(resetFrame);
      resetFrame = 0;
      track.classList.remove("is-resetting", "is-dragging");
      track.classList.add("is-animating");
      track.style.transform = transform;
    };

    const clearAutoplay = () => {
      if (autoplayTimer === undefined) return;
      window.clearTimeout(autoplayTimer);
      autoplayTimer = undefined;
    };

    const canAutoplay = () =>
      !reducedMotion &&
      count > 1 &&
      slideOffsets.length > 0 &&
      inView &&
      !pointerOver &&
      !pointerInteracting &&
      !focusWithin &&
      document.visibilityState === "visible";

    const scheduleAutoplay = () => {
      clearAutoplay();
      if (!canAutoplay()) return;
      autoplayTimer = window.setTimeout(() => {
        autoplayTimer = undefined;
        moveBy(1, false);
      }, 5000);
    };

    const normalizeLoop = () => {
      if (renderedIndex < cloneCount) renderedIndex += count;
      else if (renderedIndex >= cloneCount + count) renderedIndex -= count;
    };

    const finishMove = () => {
      transitioning = false;
      track.classList.remove("is-animating");
      normalizeLoop();
      setTrackPosition(renderedIndex, false);
      syncUi(announceAfterMove);
      announceAfterMove = false;
      scheduleAutoplay();
    };

    const moveBy = (delta: number, userInitiated: boolean) => {
      clearAutoplay();
      if (transitioning || !delta) {
        scheduleAutoplay();
        return;
      }
      renderedIndex += delta;
      logicalIndex = modulo(logicalIndex + delta, count);
      announceAfterMove = userInitiated;
      transitioning = !reducedMotion;
      syncUi(false);
      setTrackPosition(renderedIndex, !reducedMotion);
      if (reducedMotion) finishMove();
    };

    const goTo = (target: number, userInitiated = true) => {
      const normalizedTarget = modulo(target, count);
      let delta = normalizedTarget - logicalIndex;
      if (delta > count / 2) delta -= count;
      else if (delta < -count / 2) delta += count;
      moveBy(delta, userInitiated);
    };

    track.addEventListener("transitionend", (event) => {
      if (event.propertyName === "transform" && transitioning) finishMove();
    }, { signal });

    prev.addEventListener("click", () => moveBy(-1, true), { signal });
    next.addEventListener("click", () => moveBy(1, true), { signal });
    dots.forEach((dot, index) => dot.addEventListener("click", () => goTo(index), { signal }));

    track.addEventListener("keydown", (event) => {
      keyboardModality = true;
      focusWithin = true;
      clearAutoplay();
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        moveBy(-1, true);
      } else if (event.key === "ArrowRight") {
        event.preventDefault();
        moveBy(1, true);
      } else if (event.key === "Home") {
        event.preventDefault();
        goTo(0);
      } else if (event.key === "End") {
        event.preventDefault();
        goTo(count - 1);
      }
    }, { signal });

    root.addEventListener("pointerenter", (event) => {
      if (event.pointerType !== "mouse") return;
      pointerOver = true;
      clearAutoplay();
    }, { signal });
    root.addEventListener("pointerleave", (event) => {
      if (event.pointerType !== "mouse") return;
      pointerOver = false;
      scheduleAutoplay();
    }, { signal });

    const updateFocusState = () => {
      const active = document.activeElement;
      focusWithin = Boolean(keyboardModality && active && (root.contains(active) || dotsBox.contains(active)));
      focusWithin ? clearAutoplay() : scheduleAutoplay();
    };
    document.addEventListener("keydown", () => { keyboardModality = true; }, { capture: true, signal });
    [root, dotsBox].forEach((element) => {
      element.addEventListener("pointerdown", () => {
        keyboardModality = false;
        focusWithin = false;
      }, { signal });
      element.addEventListener("focusin", () => {
        if (!keyboardModality) return;
        focusWithin = true;
        clearAutoplay();
      }, { signal });
      element.addEventListener("focusout", () => {
        if (focusFrame !== undefined) window.clearTimeout(focusFrame);
        focusFrame = window.setTimeout(updateFocusState, 0);
      }, { signal });
    });

    let activePointer: number | undefined;
    let startX = 0;
    let startY = 0;
    let baseX = 0;
    let gestureAxis: "x" | "y" | undefined;
    let dragging = false;
    let suppressClick = false;

    viewport.addEventListener("pointerdown", (event) => {
      if (!event.isPrimary || event.button !== 0 || transitioning) return;
      activePointer = event.pointerId;
      startX = event.clientX;
      startY = event.clientY;
      baseX = -slideOffset(renderedIndex);
      gestureAxis = undefined;
      dragging = false;
      pointerInteracting = true;
      clearAutoplay();
      viewport.setPointerCapture(event.pointerId);
    }, { signal });

    viewport.addEventListener("pointermove", (event) => {
      if (event.pointerId !== activePointer) return;
      const dx = event.clientX - startX;
      const dy = event.clientY - startY;
      if (!gestureAxis && (Math.abs(dx) > 9 || Math.abs(dy) > 9)) {
        gestureAxis = Math.abs(dx) > Math.abs(dy) ? "x" : "y";
      }
      if (gestureAxis !== "x") return;
      dragging = true;
      event.preventDefault();
      track.classList.add("is-dragging");
      track.style.transform = `translate3d(${baseX + dx * .88}px, 0, 0)`;
    }, { signal });

    const endPointer = (event: PointerEvent, cancelled = false) => {
      if (event.pointerId !== activePointer) return;
      const dx = event.clientX - startX;
      const dy = event.clientY - startY;
      const threshold = Math.min(84, Math.max(44, viewport.clientWidth * .08));
      const isSwipe = !cancelled && dragging && Math.abs(dx) >= threshold && Math.abs(dx) > Math.abs(dy) * 1.15;
      try { viewport.releasePointerCapture(event.pointerId); } catch { /* capture may already be released */ }
      activePointer = undefined;
      pointerInteracting = false;
      track.classList.remove("is-dragging");

      if (isSwipe) {
        suppressClick = true;
        window.setTimeout(() => { suppressClick = false; }, 0);
        moveBy(dx < 0 ? 1 : -1, true);
      } else if (dragging) {
        transitioning = !reducedMotion;
        setTrackPosition(renderedIndex, !reducedMotion);
        if (reducedMotion) finishMove();
      } else {
        scheduleAutoplay();
      }
      dragging = false;
      gestureAxis = undefined;
    };

    viewport.addEventListener("pointerup", (event) => endPointer(event), { signal });
    viewport.addEventListener("pointercancel", (event) => endPointer(event, true), { signal });
    root.addEventListener("click", (event) => {
      if (!suppressClick) return;
      event.preventDefault();
      event.stopPropagation();
    }, { capture: true, signal });

    const handleVisibility = () => document.visibilityState === "visible" ? scheduleAutoplay() : clearAutoplay();
    document.addEventListener("visibilitychange", handleVisibility, { signal });

    const visibilityObserver = "IntersectionObserver" in window
      ? new IntersectionObserver(([entry]) => {
          inView = entry.isIntersecting;
          inView ? scheduleAutoplay() : clearAutoplay();
        }, { threshold: .2 })
      : undefined;
    visibilityObserver?.observe(root);

    const syncLayout = () => {
      cancelAnimationFrame(resizeFrame);
      resizeFrame = requestAnimationFrame(() => {
        resizeFrame = 0;
        if (dragging) return;
        // Read all geometry first and write transform/classes afterwards.
        slideOffsets = renderedSlides.map((slide) => slide.offsetLeft);
        transitioning = false;
        normalizeLoop();
        setTrackPosition(renderedIndex, false);
        syncUi(false);
        scheduleAutoplay();
      });
    };
    const resizeObserver = "ResizeObserver" in window ? new ResizeObserver(syncLayout) : undefined;
    resizeObserver?.observe(viewport);
    window.addEventListener("load", syncLayout, { once: true, signal });

    const handleMotionChange = (event: MediaQueryListEvent) => {
      reducedMotion = event.matches;
      transitioning = false;
      normalizeLoop();
      setTrackPosition(renderedIndex, false);
      reducedMotion ? clearAutoplay() : scheduleAutoplay();
    };
    motionQuery.addEventListener("change", handleMotionChange, { signal });

    const cleanup = () => {
      clearAutoplay();
      if (focusFrame !== undefined) window.clearTimeout(focusFrame);
      cancelAnimationFrame(resizeFrame);
      cancelAnimationFrame(resetFrame);
      controller.abort();
      visibilityObserver?.disconnect();
      resizeObserver?.disconnect();
      renderedSlides.filter((slide) => slide.dataset.clone === "true").forEach((slide) => slide.remove());
      dots.forEach((dot) => dot.remove());
      root.__reviewsCarouselCleanup = undefined;
    };
    root.__reviewsCarouselCleanup = cleanup;
    document.addEventListener("astro:before-swap", cleanup, { once: true, signal });

    syncUi(false);
    syncLayout();
  };

  let pendingObserver: IntersectionObserver | undefined;
  const init = () => {
    pendingObserver?.disconnect();
    const roots = [...document.querySelectorAll<CarouselRoot>("[data-carousel]")]
      .filter((root) => !root.__reviewsCarouselCleanup);
    if (!roots.length) return;

    if (!("IntersectionObserver" in window)) {
      roots.forEach(setup);
      return;
    }

    // Initialize shortly before the carousel can be seen, keeping clone and
    // measurement work out of the initial render.
    pendingObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const root = entry.target as CarouselRoot;
        pendingObserver?.unobserve(root);
        setup(root);
      });
    }, { rootMargin: "600px 0px" });
    roots.forEach((root) => pendingObserver?.observe(root));
  };
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", init, { once: true });
  else init();
  document.addEventListener("astro:page-load", init);
  document.addEventListener("astro:before-swap", () => pendingObserver?.disconnect());
</script>