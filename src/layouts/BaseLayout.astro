---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FloatingActions from "../components/FloatingActions.astro";
import SeoHead from "../components/SeoHead.astro";
import { languageTagByCode, type BreadcrumbItem, type PageSchemaType } from "../config/seo";
import { type Language, type PageKey } from "../i18n/config";
import { BUSINESS_NAME } from "../config/business";

interface Props {
  title: string;
  description: string;
  lang?: Language;
  page?: PageKey;
  canonicalPath?: string;
  image?: string;
  imageAlt?: string;
  socialImage?: string;
  socialImageAlt?: string;
  pageType?: "website" | "article";
  schemaType?: PageSchemaType;
  schema?: Record<string, unknown>;
  breadcrumbs?: BreadcrumbItem[];
  dateModified?: string;
  floatingHeader?: boolean;
  localizedAlternates?: boolean;
  languagePaths?: Partial<Record<Language, string>>;
  hideHeader?: boolean;
  hideFooter?: boolean;
  preloadImage?: boolean;
  preloadImageHref?: string;
  preloadImageType?: string;
  preloadImageSrcset?: string;
  preloadImageSizes?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  lang = "es",
  page = "home",
  canonicalPath = Astro.url.pathname,
  image = "/images/hero-tr3c3-coffee-brunch.webp",
  imageAlt = `${BUSINESS_NAME} en Miami Platja`,
  socialImage,
  socialImageAlt,
  pageType = "website",
  schemaType = "WebPage",
  schema,
  breadcrumbs,
  dateModified,
  floatingHeader = false,
  localizedAlternates = true,
  languagePaths,
  hideHeader = false,
  hideFooter = false,
  preloadImage = false,
  preloadImageHref,
  preloadImageType,
  preloadImageSrcset,
  preloadImageSizes,
  noindex = false,
} = Astro.props;
const layoutCopy: Record<Language, { skip: string }> = {
  es: { skip: "Saltar al contenido" },
  ca: { skip: "Saltar al contingut" },
  en: { skip: "Skip to content" },
  fr: { skip: "Aller au contenu" },
  de: { skip: "Zum Inhalt springen" },
  zh: { skip: "跳到主要内容" },
  nl: { skip: "Ga naar de inhoud" },
  it: { skip: "Vai al contenuto" },
};
const skipLabel = layoutCopy[lang]?.skip ?? layoutCopy.es.skip;
const themeColor = floatingHeader ? "#2a1c12" : "#f3e7d6";
---

<!doctype html>
<html lang={languageTagByCode[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={themeColor} />
    <SeoHead
      title={title}
      description={description}
      lang={lang}
      page={page}
      canonicalPath={canonicalPath}
      image={image}
      imageAlt={imageAlt}
      socialImage={socialImage}
      socialImageAlt={socialImageAlt}
      pageType={pageType}
      schemaType={schemaType}
      schema={schema}
      breadcrumbs={breadcrumbs}
      dateModified={dateModified}
      localizedAlternates={localizedAlternates}
      languagePaths={languagePaths}
      noindex={noindex}
    />
    {preloadImage && (preloadImageSrcset
      ? <link rel="preload" as="image" href={preloadImageHref ?? image} type={preloadImageType} imagesrcset={preloadImageSrcset} imagesizes={preloadImageSizes ?? "100vw"} fetchpriority="high" />
      : <link rel="preload" as="image" href={preloadImageHref ?? image} type={preloadImageType} fetchpriority="high" />)}
    <noscript><style>{".reveal{opacity:1!important;transform:none!important}.cp-directory__grid .cp-card{opacity:1!important;transform:none!important}[data-loop-motion] *{animation-play-state:running!important}"}</style></noscript>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{skipLabel}</a>
    {!hideHeader && <Header lang={lang} page={page} floating={floatingHeader} languagePaths={languagePaths} />}
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    {!hideFooter && <Footer lang={lang} />}
    <FloatingActions lang={lang} />
    <script>import "../scripts/site.ts";</script>
  </body>
</html>
