# TR3C3 — Apache/Hostalia: canonicalizacion, redirecciones, compresion y cache.

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Host canonico: trecemiami.com. Compatible con proxy HTTPS mediante X-Forwarded-Proto.
  RewriteCond %{HTTP_HOST} !^trecemiami\.com$ [NC]
  RewriteRule ^ https://trecemiami.com%{REQUEST_URI} [R=301,L,NE]

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://trecemiami.com%{REQUEST_URI} [R=301,L,NE]

  # Rutas históricas y contenidos consolidados. Reglas exactas para evitar cadenas.
  RewriteRule ^menu/?$ /es/carta/ [R=301,L,NE]
  RewriteRule ^contacto/?$ /es/contacto/ [R=301,L,NE]
  RewriteRule ^(?:nosotros|equipo)/?$ /es/ [R=301,L,NE]
  RewriteRule ^(es|ca|en|fr|de|zh|nl|it)/(?:nosotros|equipo)/?$ /$1/ [R=301,L,NE]
  RewriteRule ^(?:cafe|brunch|kitchen)/?$ /es/carta/ [R=301,L,NE]
  RewriteRule ^brunch-miami-platja/?$ /mejor-brunch-miami-platja/ [R=301,L,NE]
  RewriteRule ^mejor-cafe-especialidad-miami-platja/?$ /mejor-cafeteria-especialidad-miami-platja/ [R=301,L,NE]
  RewriteRule ^(?:mejores-cafeterias-miami-platja|cafeteria-premium-miami-platja|donde-tomar-cafe-miami-platja)/?$ /mejor-cafeteria-especialidad-miami-platja/ [R=301,L,NE]
  RewriteRule ^desayunos-miami-platja/?$ /mejor-brunch-miami-platja/ [R=301,L,NE]
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json image/svg+xml application/xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/xml application/rss+xml
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType image/avif .avif
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On

  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/avif "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType application/manifest+json "access plus 1 day"
  ExpiresByType application/xml "access plus 1 hour"

  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.[0-9a-zA-Z_-]{8,}\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
