# TR3C3 — Apache config para hosting estático (Hostalia)
# Solo compresión, cache y MIME. No incluye redirecciones (las gestiona Astro).

# ----------------------------------------------------------------------
# Compresión
# ----------------------------------------------------------------------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json image/svg+xml application/xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/xml application/rss+xml
</IfModule>

# ----------------------------------------------------------------------
# MIME types
# ----------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType image/avif .avif
  AddType image/svg+xml .svg
</IfModule>

# ----------------------------------------------------------------------
# Cache-Control
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # Assets con hash en el nombre (CSS/JS de Astro) — cache permanente
  <FilesMatch "\.[0-9a-zA-Z_-]{8,}\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Fuentes — cambian rara vez
  ExpiresByType font/woff2 "access plus 1 year"
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Imágenes
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/avif "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/x-icon "access plus 1 year"

  # CSS/JS sin hash (por si acaso)
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"

  # HTML — siempre revalidar para reflejar cambios de contenido
  ExpiresByType text/html "access plus 0 seconds"
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ----------------------------------------------------------------------
# Cabeceras de seguridad básicas (sin romper nada)
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
